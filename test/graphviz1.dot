digraph G {
  rankdir=LR;
  "start"[shape=circle label=""];
  "end"[shape=doublecircle label=""];
  "receive"[shape=rectangle label="Receive order"];
  "check"[shape=box style=rounded label="Check \"stock\""];
  "x1"[shape=diamond label="X"];
  "x2"[shape=diamond label="X"];
  "produce"[shape=box label="Produce (A-Z)"];
  "p1"[shape=diamond label="AND"];
  "p2"[shape=diamond label="AND"];
  "ship"[shape=box label="Ship"];
  "invoice"[shape=record style=rounded label="{S|Write invoice}"];
  "start" -> "receive";
  "receive" -> "check";
  "check" -> "x1";
  "x1" -> "produce"[label="data.stock < 1"];
  "x1" -> "x2";
  "produce" -> "x2";
  "x2" -> "p1";
  "p1" -> "ship";
  "p1" -> "invoice";
  "ship" -> "p2";
  "invoice" -> "p2";
  "p2" -> "end";
}
